# free-router 开发期校验用环境变量模板
#
# 用法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 只填写你要更新/校验的 provider 对应的 Key（其余留空即可）
#   3. 运行校验：            make verify-free-models
#      （没有 Key 的 provider 会被自动跳过；带 Key 的 provider 会发最小真实请求确认模型可调用）
#
# 注意：.env 含有密钥，已被 .gitignore 忽略，请勿提交。

# ── Provider API Key（只填你本次要维护的） ──────────────────────────────
BIGMODEL_API_KEY=              # bigmodel
COHERE_API_KEY=                # cohere
DASHSCOPE_API_KEY=             # dashscope
GEMINI_API_KEY=                # gemini
GITHUB_TOKEN=                  # github-models
GROQ_API_KEY=                  # groq
HF_TOKEN=                      # huggingface
MISTRAL_API_KEY=               # mistral
MODELSCOPE_API_KEY=            # modelscope
NVIDIA_API_KEY=                # nvidia
OLLAMA_API_KEY=                # ollama-cloud
OPENROUTER_API_KEY=            # openrouter
POLLINATIONS_API_KEY=         # pollinations
SAMBANOVA_API_KEY=             # sambanova
SILICONFLOW_API_KEY=           # siliconflow
MIMO_API_KEY=                  # xiaomi-mimo
WQ_API_KEY=                    # wanqing
XFYUN_API_KEY=                 # xfyun
ZAI_API_KEY=                   # zai

# cloudflare 需要 Account ID 才能调用 Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# volcengine-ark（火山方舟）需要 API Key
ARK_API_KEY=

# ── 可选：覆盖内置清单 / 运行配置（一般不需要） ───────────────────────────
# FREE_ROUTER_FREE_MODELS=internal/provider/free-models
# FREE_ROUTER_ADDR=127.0.0.1:1314
# FREE_ROUTER_ADMIN_TOKEN=
